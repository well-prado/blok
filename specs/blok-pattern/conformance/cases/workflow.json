{
	"about": "Running a workflow: how strings are filled in, how conditions are read, and what each kind of entry does.",
	"cases": [
		{
			"name": "a step reads what an earlier step produced, and the workflow answers with its last step",
			"workflows": {
				"sum": {
					"name": "Sum",
					"steps": [
						{
							"name": "first",
							"node": "test/add@1",
							"inputs": {
								"a": "${request.body.a}",
								"b": "${request.body.b}"
							}
						},
						{
							"name": "second",
							"node": "test/add@1",
							"inputs": {
								"a": "${first.sum}",
								"b": 10
							}
						},
						{
							"name": "third",
							"node": "test/add@1",
							"inputs": {
								"a": "${prev.sum}",
								"b": 100
							}
						}
					]
				}
			},
			"runs": [
				{
					"call": "workflows/sum@1",
					"input": {
						"body": {
							"a": 1,
							"b": 2
						}
					},
					"output": {
						"sum": 113
					},
					"spans": [
						{
							"id": "test/add@1",
							"kind": "node",
							"parent": "workflows/sum@1",
							"key": "first",
							"attempts": 1,
							"ok": true
						},
						{
							"id": "test/add@1",
							"kind": "node",
							"parent": "workflows/sum@1",
							"key": "second",
							"attempts": 1,
							"ok": true
						},
						{
							"id": "test/add@1",
							"kind": "node",
							"parent": "workflows/sum@1",
							"key": "third",
							"attempts": 1,
							"ok": true
						},
						{
							"id": "workflows/sum@1",
							"kind": "workflow",
							"attempts": 1,
							"ok": true
						}
					]
				}
			],
			"built": {
				"workflows/sum@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"a": {
										"type": "number"
									},
									"b": {
										"type": "number"
									}
								},
								"required": ["a", "b"]
							}
						},
						"required": ["body"]
					}
				}
			}
		},
		{
			"name": "a string that is one placeholder keeps the value's kind, and text around a placeholder makes text",
			"workflows": {
				"shapes": {
					"name": "Shapes",
					"steps": [
						{
							"name": "sum",
							"node": "test/add@1",
							"inputs": {
								"a": 1,
								"b": 2
							}
						},
						{
							"name": "list",
							"node": "test/items@1"
						}
					],
					"result": {
						"number": "${sum.sum}",
						"text": "total ${sum.sum}",
						"whole": "${sum}",
						"mixed": ["${sum.sum}", "x", 5, true, null],
						"nested": {
							"first": "${list.items.0.sku}",
							"count": "${list.total}"
						},
						"escaped": "$${sum.sum} costs $5",
						"object": "it is ${sum}",
						"items": "${list.items}",
						"spaced": "${ sum.sum }"
					}
				}
			},
			"runs": [
				{
					"call": "workflows/shapes@1",
					"input": {},
					"output": {
						"number": 3,
						"text": "total 3",
						"whole": {
							"sum": 3
						},
						"mixed": [3, "x", 5, true, null],
						"nested": {
							"first": "book",
							"count": 7
						},
						"escaped": "${sum.sum} costs $5",
						"object": "it is {\"sum\":3}",
						"items": [
							{
								"sku": "book",
								"qty": 2
							},
							{
								"sku": "pen",
								"qty": 5
							}
						],
						"spaced": 3
					}
				}
			],
			"built": {
				"workflows/shapes@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				}
			}
		},
		{
			"name": "text is made the same way from every kind of value, and nothing cannot be made into text",
			"workflows": {
				"text": {
					"name": "Text",
					"steps": [
						{
							"name": "e",
							"node": "test/echo@1",
							"inputs": {
								"value": "${request.body.value}"
							}
						}
					],
					"result": {
						"text": "<${e.value}>"
					}
				}
			},
			"runs": [
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": "a"
						}
					},
					"output": {
						"text": "<a>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 2
						}
					},
					"output": {
						"text": "<2>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 2
						}
					},
					"output": {
						"text": "<2>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 1.5
						}
					},
					"output": {
						"text": "<1.5>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": -0.25
						}
					},
					"output": {
						"text": "<-0.25>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 0.000001
						}
					},
					"output": {
						"text": "<0.000001>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 1e-7
						}
					},
					"output": {
						"text": "<1e-7>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 123456789012345680000
						}
					},
					"output": {
						"text": "<123456789012345680000>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": 1e21
						}
					},
					"output": {
						"text": "<1e+21>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": true
						}
					},
					"output": {
						"text": "<true>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": false
						}
					},
					"output": {
						"text": "<false>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": [1, "b", false, null]
						}
					},
					"output": {
						"text": "<[1,\"b\",false,null]>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": {
								"a": {
									"b": null
								},
								"c": "é"
							}
						}
					},
					"output": {
						"text": "<{\"a\":{\"b\":null},\"c\":\"é\"}>"
					}
				},
				{
					"call": "workflows/text@1",
					"input": {
						"body": {
							"value": null
						}
					},
					"error": {
						"code": "workflow_ref",
						"node": "workflows/text@1",
						"message": "\"<${e.value}>\" has an empty placeholder."
					}
				}
			],
			"built": {
				"workflows/text@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"value": {}
								},
								"required": ["value"]
							}
						},
						"required": ["body"]
					}
				}
			}
		},
		{
			"name": "a number that came out whole is written as a whole number, and is equal to one",
			"workflows": {
				"whole": {
					"name": "Whole",
					"steps": [
						{
							"name": "sum",
							"node": "test/add@1",
							"inputs": {
								"a": 1.5,
								"b": 0.5
							}
						},
						{
							"name": "is-two",
							"node": "test/record@1",
							"inputs": {
								"note": "it is 2"
							},
							"if": "${sum.sum} == 2"
						},
						{
							"name": "at-least-two",
							"node": "test/record@1",
							"inputs": {
								"note": "at least 2"
							},
							"if": "${sum.sum} >= 2"
						}
					],
					"result": {
						"text": "sum ${sum.sum}",
						"n": "${sum.sum}"
					}
				}
			},
			"runs": [
				{
					"call": "workflows/whole@1",
					"input": {},
					"output": {
						"text": "sum 2",
						"n": 2
					},
					"journal": ["it is 2", "at least 2"]
				}
			],
			"built": {
				"workflows/whole@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				}
			}
		},
		{
			"name": "a field that is not there is simply absent, and reading through nothing is an error",
			"workflows": {
				"absent": {
					"name": "Absent",
					"steps": [
						{
							"name": "e",
							"node": "test/echo@1",
							"inputs": {
								"value": "${request.body.value}"
							}
						},
						{
							"name": "g",
							"node": "test/greet@1",
							"inputs": {
								"name": "${e.value.name}",
								"greeting": "${e.value.greeting}"
							}
						}
					]
				},
				"beyond": {
					"name": "Beyond",
					"steps": [
						{
							"name": "list",
							"node": "test/items@1"
						}
					],
					"result": {
						"item": "${list.items.5}",
						"kept": "${list.total}",
						"in-a-list": ["${list.items.5}"]
					}
				},
				"through": {
					"name": "Through",
					"steps": [
						{
							"name": "list",
							"node": "test/items@1"
						}
					],
					"result": {
						"sku": "${list.items.5.sku}"
					}
				}
			},
			"runs": [
				{
					"call": "workflows/absent@1",
					"input": {
						"body": {
							"value": {
								"name": "Ada"
							}
						}
					},
					"output": {
						"text": "Hello, Ada!"
					}
				},
				{
					"call": "workflows/absent@1",
					"input": {
						"body": {
							"value": {
								"name": "Ada",
								"greeting": "Hi"
							}
						}
					},
					"output": {
						"text": "Hi, Ada!"
					}
				},
				{
					"call": "workflows/absent@1",
					"input": {
						"body": {
							"value": {
								"greeting": "Hi"
							}
						}
					},
					"error": {
						"code": "invalid_input",
						"node": "test/greet@1"
					}
				},
				{
					"call": "workflows/absent@1",
					"input": {
						"body": {
							"value": {
								"name": "Ada",
								"greeting": null
							}
						}
					},
					"error": {
						"code": "invalid_input",
						"node": "test/greet@1"
					}
				},
				{
					"call": "workflows/absent@1",
					"input": {
						"body": {
							"value": null
						}
					},
					"error": {
						"code": "workflow_ref",
						"node": "workflows/absent@1",
						"message": "\"${e.value.name}\" has nothing at \"name\"."
					}
				},
				{
					"call": "workflows/absent@1",
					"input": {
						"body": {
							"value": "text"
						}
					},
					"error": {
						"code": "workflow_ref",
						"node": "workflows/absent@1",
						"message": "\"${e.value.name}\" has nothing at \"name\"."
					}
				},
				{
					"call": "workflows/beyond@1",
					"input": {},
					"output": {
						"kept": 7,
						"in-a-list": [null]
					}
				},
				{
					"call": "workflows/through@1",
					"input": {},
					"error": {
						"code": "workflow_ref",
						"node": "workflows/through@1",
						"message": "\"${list.items.5.sku}\" has nothing at \"sku\"."
					}
				}
			],
			"built": {
				"workflows/absent@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"value": {}
								},
								"required": ["value"]
							}
						},
						"required": ["body"]
					}
				},
				"workflows/beyond@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				},
				"workflows/through@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				}
			}
		},
		{
			"name": "a workflow reads the environment it was loaded with",
			"env": {
				"REGION": "eu"
			},
			"workflows": {
				"where": {
					"name": "Where",
					"steps": [
						{
							"name": "one",
							"node": "test/add@1",
							"inputs": {
								"a": 1,
								"b": 1
							}
						}
					],
					"result": {
						"region": "${env.REGION}",
						"text": "in ${env.REGION}"
					}
				}
			},
			"runs": [
				{
					"call": "workflows/where@1",
					"input": {},
					"output": {
						"region": "eu",
						"text": "in eu"
					}
				}
			],
			"built": {
				"workflows/where@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				}
			}
		},
		{
			"name": "an if decides whether a step runs",
			"workflows": {
				"gate": {
					"name": "Gate",
					"steps": [
						{
							"name": "big",
							"node": "test/record@1",
							"inputs": {
								"note": "big"
							},
							"if": "${request.body.n} > 10"
						},
						{
							"name": "small",
							"node": "test/record@1",
							"inputs": {
								"note": "small"
							},
							"if": "${request.body.n} <= 10"
						},
						{
							"name": "ten",
							"node": "test/record@1",
							"inputs": {
								"note": "exactly ten"
							},
							"if": "${request.body.n} == 10"
						},
						{
							"name": "not-ten",
							"node": "test/record@1",
							"inputs": {
								"note": "not ten"
							},
							"if": "${request.body.n}!=10"
						},
						{
							"name": "at-least",
							"node": "test/record@1",
							"inputs": {
								"note": "at least m"
							},
							"if": "${request.body.n} >= ${request.body.m}"
						},
						{
							"name": "below",
							"node": "test/record@1",
							"inputs": {
								"note": "below m"
							},
							"if": "  ${request.body.n} < ${request.body.m}  "
						},
						{
							"name": "flagged",
							"node": "test/record@1",
							"inputs": {
								"note": "flagged"
							},
							"if": "${request.body.flag}"
						}
					],
					"result": {
						"done": true
					}
				}
			},
			"runs": [
				{
					"call": "workflows/gate@1",
					"input": {
						"body": {
							"n": 11,
							"m": 11,
							"flag": true
						}
					},
					"output": {
						"done": true
					},
					"journal": ["big", "not ten", "at least m", "flagged"]
				},
				{
					"call": "workflows/gate@1",
					"input": {
						"body": {
							"n": 10,
							"m": 20,
							"flag": false
						}
					},
					"output": {
						"done": true
					},
					"journal": ["small", "exactly ten", "below m"]
				},
				{
					"call": "workflows/gate@1",
					"input": {
						"body": {
							"n": 10.5,
							"m": 10.5,
							"flag": false
						}
					},
					"output": {
						"done": true
					},
					"journal": ["big", "not ten", "at least m"]
				}
			],
			"built": {
				"workflows/gate@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"n": {
										"type": "integer"
									},
									"m": {},
									"flag": {
										"type": "boolean"
									}
								}
							}
						}
					}
				}
			}
		},
		{
			"name": "equal means the same kind and the same value: text is not a number, and 1 is not true",
			"workflows": {
				"compare": {
					"name": "Compare",
					"steps": [
						{
							"name": "e",
							"node": "test/echo@1",
							"inputs": {
								"value": "${request.body.value}"
							}
						},
						{
							"name": "is-word",
							"node": "test/record@1",
							"inputs": {
								"note": "word"
							},
							"if": "${e.value} == open"
						},
						{
							"name": "is-quoted",
							"node": "test/record@1",
							"inputs": {
								"note": "quoted"
							},
							"if": "${e.value} == 'two words'"
						},
						{
							"name": "is-double",
							"node": "test/record@1",
							"inputs": {
								"note": "double"
							},
							"if": "${e.value} == \"two words\""
						},
						{
							"name": "is-five",
							"node": "test/record@1",
							"inputs": {
								"note": "five"
							},
							"if": "${e.value} == 5"
						},
						{
							"name": "is-negative",
							"node": "test/record@1",
							"inputs": {
								"note": "negative"
							},
							"if": "${e.value} == -2.5"
						},
						{
							"name": "is-true",
							"node": "test/record@1",
							"inputs": {
								"note": "true"
							},
							"if": "${e.value} == true"
						},
						{
							"name": "is-false",
							"node": "test/record@1",
							"inputs": {
								"note": "false"
							},
							"if": "${e.value} == false"
						},
						{
							"name": "is-null",
							"node": "test/record@1",
							"inputs": {
								"note": "null"
							},
							"if": "${e.value} == null"
						},
						{
							"name": "is-something",
							"node": "test/record@1",
							"inputs": {
								"note": "something"
							},
							"if": "${e.value} != null"
						}
					],
					"result": {
						"done": true
					}
				}
			},
			"runs": [
				{
					"call": "workflows/compare@1",
					"input": {
						"body": {
							"value": "open"
						}
					},
					"journal": ["word", "something"]
				},
				{
					"call": "workflows/compare@1",
					"input": {
						"body": {
							"value": "two words"
						}
					},
					"journal": ["quoted", "double", "something"]
				},
				{
					"call": "workflows/compare@1",
					"input": {
						"body": {
							"value": 5
						}
					},
					"journal": ["five", "something"]
				},
				{
					"call": "workflows/compare@1",
					"input": {
						"body": {
							"value": 5
						}
					},
					"journal": ["five", "something"]
				},
				{
					"call": "workflows/compare@1",
					"input": {
						"body": {
							"value": "5"
						}
					},
					"journal": ["something"]
				},
