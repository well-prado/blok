{
	"about": "Answering an HTTP request: which status, which body, what stays out of the answer and goes to the log, and when a signed request is let in.",
	"cases": [
		{
			"name": "a success answers with 200, or with the status the trigger names",
			"workflows": {
				"plain": {
					"name": "Plain",
					"trigger": {
						"http": {
							"method": "GET",
							"path": "/plain"
						}
					},
					"steps": [
						{
							"name": "sum",
							"node": "test/add@1",
							"inputs": {
								"a": 1,
								"b": 2
							}
						}
					]
				},
				"create": {
					"name": "Create",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/things",
							"status": 201,
							"errors": {
								"refused": 409
							}
						}
					},
					"steps": [
						{
							"name": "try",
							"node": "test/maybe@1",
							"inputs": {
								"ok": "${request.body.ok}",
								"note": "x"
							}
						}
					]
				}
			},
			"requests": [
				{
					"to": "workflows/plain@1",
					"request": {
						"method": "GET"
					},
					"status": 200,
					"body": {
						"sum": 3
					}
				},
				{
					"to": "workflows/create@1",
					"request": {
						"method": "POST",
						"body": {
							"ok": true
						}
					},
					"status": 201,
					"body": {
						"note": "x"
					}
				}
			],
			"built": {
				"workflows/plain@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				},
				"workflows/create@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"ok": {
										"type": "boolean"
									}
								},
								"required": ["ok"]
							}
						},
						"required": ["body"]
					}
				}
			}
		},
		{
			"name": "a failure the trigger gives a status answers with it, and says the code, the message and the node",
			"workflows": {
				"create": {
					"name": "Create",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/things",
							"status": 201,
							"errors": {
								"refused": 409
							}
						}
					},
					"steps": [
						{
							"name": "try",
							"node": "test/maybe@1",
							"inputs": {
								"ok": "${request.body.ok}",
								"note": "x"
							}
						}
					]
				},
				"strict": {
					"name": "Strict",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/strict",
							"errors": {
								"invalid_input": 422
							}
						}
					},
					"steps": [
						{
							"name": "sum",
							"node": "test/add@1",
							"inputs": {
								"a": "${request.body.a}",
								"b": 1
							}
						}
					]
				},
				"draft": {
					"name": "Draft",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/draft"
						}
					},
					"steps": [
						{
							"name": "later",
							"node": "test/empty@1",
							"inputs": {
								"name": "${request.body.name}"
							}
						}
					]
				}
			},
			"requests": [
				{
					"to": "workflows/create@1",
					"request": {
						"method": "POST",
						"body": {
							"ok": false
						}
					},
					"status": 409,
					"body": {
						"error": "refused",
						"message": "It was refused: x",
						"node": "test/maybe@1"
					},
					"logged": []
				},
				{
					"to": "workflows/create@1",
					"request": {
						"method": "POST",
						"body": {}
					},
					"status": 400,
					"body": {
						"error": "invalid_input",
						"message": "The request is missing: body.ok.",
						"node": "workflows/create@1"
					}
				},
				{
					"to": "workflows/strict@1",
					"request": {
						"method": "POST",
						"body": {}
					},
					"status": 422,
					"body": {
						"error": "invalid_input",
						"message": "The request is missing: body.a.",
						"node": "workflows/strict@1"
					}
				},
				{
					"to": "workflows/draft@1",
					"request": {
						"method": "POST",
						"body": {
							"name": "Ada"
						}
					},
					"status": 501,
					"body": {
						"error": "not_implemented",
						"message": "test/empty@1 is not implemented yet.",
						"node": "test/empty@1"
					}
				}
			],
			"built": {
				"workflows/create@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"ok": {
										"type": "boolean"
									}
								},
								"required": ["ok"]
							}
						},
						"required": ["body"]
					}
				},
				"workflows/strict@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"a": {
										"type": "number"
									}
								},
								"required": ["a"]
							}
						},
						"required": ["body"]
					}
				},
				"workflows/draft@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									}
								},
								"required": ["name"]
							}
						},
						"required": ["body"]
					}
				}
			}
		},
		{
			"name": "a failure nobody planned for answers 500 and says nothing about what broke, which goes to the log",
			"workflows": {
				"broken": {
					"name": "Broken",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/broken"
						}
					},
					"steps": [
						{
							"name": "crash",
							"node": "test/crash@1"
						}
					]
				},
				"late": {
					"name": "Late",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/late"
						}
					},
					"steps": [
						{
							"name": "wait",
							"node": "test/slow@1",
							"inputs": {
								"ms": 400
							}
						}
					]
				}
			},
			"requests": [
				{
					"to": "workflows/broken@1",
					"request": {
						"method": "POST",
						"body": {}
					},
					"status": 500,
					"body": {
						"error": "unexpected",
						"message": "The server could not complete the request."
					},
					"logged": [
						"workflows/broken@1 failed with \"unexpected\" at test/crash@1: the database is down"
					]
				},
				{
					"to": "workflows/late@1",
					"request": {
						"method": "POST",
						"body": {}
					},
					"status": 500,
					"body": {
						"error": "timeout",
						"message": "The server could not complete the request."
					},
					"logged": [
						"workflows/late@1 failed with \"timeout\" at test/slow@1: test/slow@1 was aborted"
					]
				}
			],
			"built": {
				"workflows/broken@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				},
				"workflows/late@1": {
					"request": {
						"type": "object",
						"properties": {}
					}
				}
			}
		},
		{
			"name": "the workflow reads the method, the query, the path parameters and the headers of the request",
			"workflows": {
				"look": {
					"name": "Look",
					"trigger": {
						"http": {
							"method": "GET",
							"path": "/shops/:shop/items/:id"
						}
					},
					"steps": [
						{
							"name": "one",
							"node": "test/add@1",
							"inputs": {
								"a": 1,
								"b": 1
							}
						}
					],
					"result": {
						"method": "${request.method}",
						"shop": "${request.params.shop}",
						"id": "${request.params.id}",
						"q": "${request.query.q}",
						"agent": "${request.headers.user-agent}"
					}
				}
			},
			"requests": [
				{
					"to": "workflows/look@1",
					"request": {
						"method": "GET",
						"params": {
							"shop": "s1",
							"id": "42"
						},
						"query": {
							"q": "pen"
						},
						"headers": {
							"user-agent": "a test"
						}
					},
					"status": 200,
					"body": {
						"method": "GET",
						"shop": "s1",
						"id": "42",
						"q": "pen",
						"agent": "a test"
					}
				}
			],
			"built": {
				"workflows/look@1": {
					"request": {
						"type": "object",
						"properties": {
							"method": {},
							"params": {
								"type": "object",
								"properties": {
									"shop": {},
									"id": {}
								}
							},
							"query": {
								"type": "object",
								"properties": {
									"q": {}
								}
							},
							"headers": {
								"type": "object",
								"properties": {
									"user-agent": {}
								}
							}
						}
					}
				}
			}
		},
		{
			"name": "a signed route lets in only a request whose signature matches its body, and that is not old",
			"env": {
				"HOOK_SECRET": {
					"whsecOf": "a secret made up for these tests"
				}
			},
			"workflows": {
				"hook": {
					"name": "Hook",
					"trigger": {
						"http": {
							"method": "POST",
							"path": "/hooks",
							"status": 202,
							"signature": {
								"scheme": "standard",
								"secret": "HOOK_SECRET"
							}
						}
					},
					"steps": [
						{
							"name": "event",
							"node": "test/record@1",
							"inputs": {
								"note": "${request.body.id}"
							}
						}
					]
				}
			},
			"requests": [
				{
					"to": "workflows/hook@1",
					"request": {
						"method": "POST",
						"headers": {
							"webhook-id": "msg_1",
							"webhook-timestamp": "1800000000",
							"webhook-signature": "v1,7jbcCvgqWzVuYP4mcK0AOE6Wl+0GdKiUzBJQkVHiB5s="
						}
					},
					"raw": "{\"id\":\"evt_1\"}",
					"now": 1800000000000,
					"status": 202,
					"body": {
						"note": "evt_1",
						"position": 1
					},
					"journal": ["evt_1"]
				},
				{
					"to": "workflows/hook@1",
					"request": {
						"method": "POST",
						"headers": {
							"webhook-id": "msg_1",
							"webhook-timestamp": "1800000000",
							"webhook-signature": "v1,7jbcCvgqWzVuYP4mcK0AOE6Wl+0GdKiUzBJQkVHiB5s="
						}
					},
					"raw": "{\"id\":\"evt_2\"}",
					"now": 1800000000000,
					"status": 401,
					"body": {
						"error": "invalid_signature",
						"message": "The signature does not match."
					},
					"journal": [],
					"logged": []
				},
				{
					"to": "workflows/hook@1",
					"request": {
						"method": "POST",
						"headers": {}
					},
					"raw": "{\"id\":\"evt_1\"}",
					"now": 1800000000000,
					"status": 401,
					"body": {
						"error": "invalid_signature",
						"message": "The signature does not match."
					},
					"journal": []
				},
				{
					"to": "workflows/hook@1",
					"request": {
						"method": "POST",
						"headers": {
							"webhook-id": "msg_1",
							"webhook-timestamp": "1800000000",
							"webhook-signature": "v1,7jbcCvgqWzVuYP4mcK0AOE6Wl+0GdKiUzBJQkVHiB5s="
						}
					},
					"raw": "{\"id\":\"evt_1\"}",
					"now": 1800000600000,
					"status": 401,
					"body": {
						"error": "invalid_signature",
						"message": "The signature does not match."
					},
					"journal": []
				},
				{
					"to": "workflows/hook@1",
					"request": {
						"method": "POST",
						"body": {
							"id": "evt_1"
						},
						"headers": {
							"webhook-id": "msg_1",
							"webhook-timestamp": "1800000000",
							"webhook-signature": "v1,7jbcCvgqWzVuYP4mcK0AOE6Wl+0GdKiUzBJQkVHiB5s="
						}
					},
					"now": 1800000000000,
					"status": 500,
					"body": {
						"error": "unexpected",
						"message": "The server could not complete the request."
					},
					"journal": [],
					"logged": [
						"workflows/hook@1 checks a signature, and the body as it arrived was gone before Blok saw the request. Mount Blok before anything that parses the body."
					]
				}
			],
			"built": {
				"workflows/hook@1": {
					"request": {
						"type": "object",
						"properties": {
							"body": {
								"type": "object",
								"properties": {
									"id": {
										"type": "string"
									}
								},
								"required": ["id"]
							}
						},
						"required": ["body"]
					}
				}
			}
		}
	],
