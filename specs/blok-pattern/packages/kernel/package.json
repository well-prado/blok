{
	"name": "@blokjs/kernel",
	"version": "3.0.0-next.0",
	"description": "Blok as a pattern: nodes with contracts, workflows as data, and one small runtime you call from your own server.",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./fastify": {
			"types": "./dist/fastify.d.ts",
			"default": "./dist/fastify.js"
		}
	},
	"files": ["dist"],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "tsc -p ."
	},
	"peerDependencies": {
		"fastify": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"fastify": {
			"optional": true
		}
	},
	"devDependencies": {
		"fastify": "^5.12.8",
		"zod": "^4.6.7"
	}
}
