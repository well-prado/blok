{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Blok workflow",
	"description": "A list of steps. Each step names a node and gives it its inputs.",
	"type": "object",
	"required": ["name", "steps"],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"version": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
		},
		"trigger": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"http": {
					"type": "object",
					"required": ["method", "path"],
					"additionalProperties": false,
					"properties": {
						"method": {
							"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
						},
						"path": {
							"type": "string",
							"pattern": "^/"
						},
						"accept": {
							"type": "string"
						},
						"errors": {
							"description": "Error code to HTTP status.",
							"type": "object",
							"additionalProperties": {
								"type": "integer",
								"minimum": 400,
								"maximum": 599
							}
						},
						"status": {
							"description": "The status of a successful answer. Default 200.",
							"type": "integer",
							"minimum": 200,
							"maximum": 299
						},
						"signature": {
							"description": "A webhook: a request is refused with 401 unless its signature matches.",
							"type": "object",
							"required": ["scheme", "secret"],
							"additionalProperties": false,
							"properties": {
								"scheme": {
									"enum": ["standard", "stripe", "github", "hmac"]
								},
								"secret": {
									"description": "The NAME of the environment variable that holds the secret. Never the secret itself.",
									"type": "string",
									"pattern": "^[A-Z][A-Z0-9_]*$"
								},
								"header": {
									"description": "For \"hmac\": the header that carries the signature.",
									"type": "string"
								},
								"encoding": {
									"enum": ["hex", "base64"]
								},
								"prefix": {
									"type": "string"
								}
							}
						}
					}
				},
				"cron": {
					"description": "Runs on a schedule.",
					"type": "object",
					"required": ["schedule"],
					"additionalProperties": false,
					"properties": {
						"schedule": {
							"description": "Five parts: minute, hour, day of month, month, day of week.",
							"type": "string",
							"minLength": 1
						},
						"timezone": {
							"description": "A time zone such as \"Europe/Lisbon\". Default UTC.",
							"type": "string"
						},
						"body": {
							"description": "What the workflow reads as request.body on every run.",
							"type": "object"
						}
					}
				},
				"queue": {
					"description": "Runs once per message of a queue. The message is request.body.",
					"type": "object",
					"required": ["name"],
					"additionalProperties": false,
					"properties": {
						"name": {
							"type": "string",
							"pattern": "^[A-Za-z0-9_.:-]+$"
						},
						"concurrency": {
							"type": "integer",
							"minimum": 1
						}
					}
				},
				"mcp": {
					"description": "Makes the workflow a tool an AI agent can call. The arguments are request.body.",
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"tool": {
							"description": "Default: the file name with underscores.",
							"type": "string",
							"pattern": "^[A-Za-z0-9_-]{1,64}$"
						},
						"description": {
							"description": "Default: the workflow's description.",
							"type": "string"
						}
					}
				}
			},
			"description": "What starts the workflow from outside. One of each kind at most."
		},
		"steps": {
			"$ref": "#/$defs/entries"
		},
		"result": {
			"description": "What the workflow answers with. Left out, it answers with the result of the last step that ran."
		}
	},
	"$defs": {
		"entries": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/entry"
			}
		},
		"entry": {
			"description": "A step, a conditions block, a parallel block or a fail entry.",
			"type": "object",
			"if": {
				"required": ["conditions"]
			},
			"then": {
				"$ref": "#/$defs/conditions"
			},
			"else": {
				"if": {
					"required": ["parallel"]
				},
				"then": {
					"$ref": "#/$defs/parallel"
				},
				"else": {
					"if": {
						"required": ["fail"]
					},
					"then": {
						"$ref": "#/$defs/fail"
					},
					"else": {
						"$ref": "#/$defs/step"
					}
				}
			}
		},
		"condition": {
			"description": "${a.b}, or ${a.b} followed by == != > >= < <= and a value.",
			"type": "string",
			"pattern": "^\\s*\\$\\{[^}]+\\}"
		},
		"step": {
			"type": "object",
			"required": ["name", "node"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]+$"
				},
				"node": {
					"description": "<module>/<node>@<version>, the folder the node lives in.",
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+@[1-9][0-9]*$"
				},
				"inputs": {
					"description": "What the node is given. Strings may hold ${...} placeholders.",
					"type": "object"
				},
				"if": {
					"$ref": "#/$defs/condition"
				},
				"each": {
					"description": "A list to run this step over. Inputs read the element as ${item}.",
					"type": "string",
					"pattern": "^\\s*\\$\\{[^}]+\\}\\s*$"
				},
				"concurrency": {
					"type": "integer",
					"minimum": 1
				},
				"onError": {
					"$ref": "#/$defs/entries"
				},
				"undo": {
					"description": "Steps that take this step back when a later step fails.",
					"$ref": "#/$defs/entries"
				}
			}
		},
		"conditions": {
			"type": "object",
			"required": ["conditions"],
			"additionalProperties": false,
			"properties": {
				"conditions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"if": {
							"required": ["else"]
						},
						"then": {
							"$ref": "#/$defs/otherwise"
						},
						"else": {
							"$ref": "#/$defs/branch"
						}
					}
				}
			}
		},
		"parallel": {
			"type": "object",
			"required": ["parallel"],
			"additionalProperties": false,
			"properties": {
				"parallel": {
					"$ref": "#/$defs/entries"
				}
			}
		},
		"branch": {
			"type": "object",
			"required": ["if", "steps"],
			"additionalProperties": false,
			"properties": {
				"if": {
					"$ref": "#/$defs/condition"
				},
				"steps": {
					"$ref": "#/$defs/entries"
				}
			}
		},
		"otherwise": {
			"type": "object",
			"required": ["else"],
			"additionalProperties": false,
			"properties": {
				"else": {
					"$ref": "#/$defs/entries"
				}
			}
		},
		"fail": {
			"description": "Refuses the request with an error code. With \"if\", only when the condition holds.",
			"type": "object",
			"required": ["fail"],
			"additionalProperties": false,
			"properties": {
				"fail": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9_]*$"
				},
				"message": {
					"type": "string"
				},
				"if": {
					"$ref": "#/$defs/condition"
				}
			}
		}
	}
}
