{
	"name": "blokctl",
	"version": "3.0.0-next.0",
	"description": "The development tool for Blok: scaffold nodes and workflows, check that everything lines up, and build the JSON production loads.",
	"private": true,
	"type": "module",
	"bin": {
		"blokctl": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "assets"],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "tsc -p ."
	},
	"dependencies": {
		"@blokjs/kernel": "3.0.0-next.0",
		"ajv": "^8.20.0"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2"
	}
}
