amends "blok/Workflow.pkl"

import "blok/catalog.pkl"
import "blok/orders.pkl"

name = "Quote"
description = "Prices every line of a basket, four at a time, then totals it."
version = "1.0.0"

trigger {
  http = new {
    method = "POST"
    path = "/quotes"
    errors { ["unknown_sku"] = 422 }
  }
}

// Not named `lines`: inside `inputs { lines = ... }` below, that name means the input itself.
local pricedLines = new catalog.PriceLine {
  name = "lines"
  each = "${request.body.items}"
  concurrency = 4
  inputs {
    sku = "${item.sku}"
    qty = "${item.qty}"
  }
}

local total = new orders.SumLines {
  name = "total"
  inputs { lines = pricedLines.value }
}

steps {
  pricedLines
  total
}

result {
  lines = pricedLines.value
  totalCents = total.outputs.totalCents
  lineCount = total.outputs.lineCount
}
