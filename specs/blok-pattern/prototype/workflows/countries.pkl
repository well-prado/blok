amends "blok/Workflow.pkl"

import "blok/http.pkl"

name = "World Countries"
description = "Lists countries and their capitals."
version = "1.0.0"

trigger {
  http = new {
    method = "GET"
    path = "/countries"
    errors { ["upstream_failed"] = 502 }
  }
}

steps {
  new http.ApiCall {
    name = "get-countries"
    inputs {
      url = "https://countriesnow.space/api/v0.1/countries/capital"
      method = "GET"
    }
  }
}
