{
	"name": "@blokjs/browser",
	"version": "2.0.0",
	"files": ["dist"],
	"description": "Playwright browser lifecycle nodes for BLOK workflows",
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"license": "Apache-2.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
