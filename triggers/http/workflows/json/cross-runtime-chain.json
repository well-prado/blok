{
	"name": "Cross-Runtime Chain Test",
	"version": "1.2.0",
	"description": "Tests all 8 language runtimes by chaining nodes via ctx.vars. Each SDK node appends its language to the chain array. A final verify node confirms all runtimes executed correctly.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/cross-runtime-chain",
			"accept": "application/json"
		}
	},
	"steps": [
		{
			"id": "init",
			"use": "chain-init",
			"type": "module",
			"inputs": {}
		},
		{
			"id": "go",
			"use": "chain-test",
			"type": "runtime.go",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "init",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "init",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "rust",
			"use": "chain-test",
			"type": "runtime.rust",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "go",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "go",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "java",
			"use": "chain-test",
			"type": "runtime.java",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "rust",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "rust",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "csharp",
			"use": "chain-test",
			"type": "runtime.csharp",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "java",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "java",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "php",
			"use": "chain-test",
			"type": "runtime.php",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "csharp",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "csharp",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "ruby",
			"use": "chain-test",
			"type": "runtime.ruby",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "php",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "php",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "python",
			"use": "chain-test",
			"type": "runtime.python3",
			"inputs": {
				"chain": {
					"$ref": {
						"step": "ruby",
						"path": [
							"chain"
						]
					}
				},
				"origin": {
					"$ref": {
						"step": "ruby",
						"path": [
							"origin"
						]
					}
				}
			}
		},
		{
			"id": "verify",
			"use": "chain-verify",
			"type": "module",
			"inputs": {}
		}
	]
}
