# @blokjs/auth — required
# Signs the session cookie AND the password-reset tokens. At least 16
# characters; there is no default, and a missing value is a boot error.
# Generate one with: openssl rand -base64 32
BLOK_SESSION_SECRET=

# Signs the one-shot flash cookie that carries validation errors across the
# redirect after a failed login. Required — every form in this kit uses it.
BLOK_FLASH_SECRET=

# Optional — where the default SQLite UserStore keeps users and reset tokens.
# Default .blok/auth.db. Ignored once you pass configureAuth({ users }).
# BLOK_AUTH_SQLITE_PATH=.blok/auth.db
