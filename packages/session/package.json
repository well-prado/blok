{
	"name": "@blokjs/session",
	"version": "2.5.0",
	"files": ["dist"],
	"description": "Signed, HttpOnly server-side sessions for Blok — pluggable store (memory / sqlite / postgres / redis), session.get/set/forget/regenerate nodes, and the inertia.session middleware.",
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"author": "Deskree Technologies Inc.",
	"license": "Apache-2.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "rimraf ./dist && tsc",
		"build:dev": "tsc --watch",
		"test": "vitest run",
		"test:dev": "vitest"
	},
	"keywords": [
		"blok",
		"session",
		"cookie",
		"sqlite",
		"postgres",
		"neon",
		"redis"
	],
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.13.5",
		"better-sqlite3": "^12.11.1",
		"rimraf": "^6.1.2",
		"typescript": "^5.8.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@blokjs/core": "^2.3.0",
		"@blokjs/shared": "^2.3.0",
		"zod": "^3.24.2"
	},
	"peerDependencies": {
		"better-sqlite3": "^11.0.0",
		"ioredis": "^5.9.2",
		"pg": "^8.18.0"
	},
	"peerDependenciesMeta": {
		"better-sqlite3": {
			"optional": true
		},
		"ioredis": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	}
}
