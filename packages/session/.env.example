# @blokjs/session — required
# Signs the session cookie. At least 16 characters; there is no default, and a
# missing value is a boot error. Generate one with: openssl rand -base64 32
BLOK_SESSION_SECRET=

# Signs the one-shot flash cookie (@blokjs/inertia's redirectBack()). Required
# as soon as anything flashes — which the auth kit does on every failed login.
BLOK_FLASH_SECRET=

# Optional — storage backend. One of: memory | sqlite | redis.
# Default: redis when REDIS_URL is set, memory under NODE_ENV=test, else sqlite.
# BLOK_SESSION_STORE=sqlite

# Optional — sqlite file. Default .blok/sessions.db
# BLOK_SESSION_SQLITE_PATH=.blok/sessions.db

# Optional — selects the redis backend when set.
# REDIS_URL=redis://127.0.0.1:6379
