{
	"name": "Data Export Pipeline",
	"version": "1.0.0",
	"description": "Exports paginated user data to S3. Counts pages, builds the page-number list, then iterates each page sequentially (rate-limit friendly). Each page fetch is wrapped in tryCatch: try with retry + maxDuration handles transient failures gracefully; catch records the failed page to a DLQ table without aborting the whole export. After the loop, an assemble step writes everything to S3 and the response includes the public URL plus row counts. Demonstrates: forEach + tryCatch nested with per-step retry, resilient ETL pattern that survives transient failures, idempotencyKey on assemble for safe replay.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/exports/users",
			"middleware": ["auth-check", "admin-only"]
		}
	},
	"steps": [
		{
			"id": "count-users",
			"use": "user-count",
			"type": "module"
		},
		{
			"id": "build-page-list",
			"use": "expr",
			"type": "module",
			"inputs": {
				"expression": "Array.from({length: Math.ceil(ctx.state['count-users'].total / 100)}, (_, i) => i + 1)"
			}
		},
		{
			"id": "fetch-pages",
			"forEach": {
				"in": "js/ctx.state['build-page-list']",
				"as": "page",
				"mode": "sequential",
				"do": [
					{
						"id": "page-fetch",
						"tryCatch": {
							"try": [
								{
									"id": "fetch",
									"use": "@blokjs/api-call",
									"type": "module",
									"retry": {
										"maxAttempts": 3,
										"minTimeoutInMs": 1000,
										"factor": 2
									},
									"maxDuration": "30s",
									"inputs": {
										"url": "https://api.example.com/users",
										"method": "GET",
										"headers": {
											"Authorization": "js/`Bearer ${ctx.env.UPSTREAM_API_TOKEN}`"
										},
										"query": {
											"page": {
												"$ref": {
													"step": "page",
													"path": []
												}
											},
											"size": 100
										}
									}
								}
							],
							"catch": [
								{
									"id": "record-failed-page",
									"use": "db-insert",
									"type": "module",
									"inputs": {
										"table": "export_failures",
										"data": {
											"exportId": {
												"$ref": {
													"step": "@trigger",
													"path": ["body", "exportId"]
												}
											},
											"page": {
												"$ref": {
													"step": "page",
													"path": []
												}
											},
											"error": {
												"$ref": {
													"step": "@error",
													"path": ["message"]
												}
											},
											"errorCode": {
												"$ref": {
													"step": "@error",
													"path": ["code"]
												}
											},
											"failedAt": "new Date().toISOString()"
										}
									}
								}
							]
						}
					}
				]
			}
		},
		{
			"id": "assemble",
			"use": "export-assemble",
			"type": "module",
			"idempotencyKey": "js/`export-${ctx.request.body.exportId}`",
			"maxDuration": "120s",
			"inputs": {
				"exportId": {
					"$ref": {
						"step": "@trigger",
						"path": ["body", "exportId"]
					}
				},
				"pages": "js/ctx.state['fetch-pages'].filter(p => p['fetch'] !== undefined)",
				"format": "csv",
				"destination": {
					"type": "s3",
					"bucket": "js/ctx.env.EXPORT_BUCKET",
					"key": {
						"$tpl": [
							"exports/",
							{
								"$ref": {
									"step": "@trigger",
									"path": ["body", "exportId"]
								}
							},
							".csv"
						]
					}
				}
			}
		},
		{
			"id": "respond",
			"use": "@blokjs/respond",
			"type": "module",
			"inputs": {
				"status": 200,
				"body": {
					"exportId": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "exportId"]
						}
					},
					"url": {
						"$ref": {
							"step": "assemble",
							"path": ["s3Url"]
						}
					},
					"rowCount": {
						"$ref": {
							"step": "assemble",
							"path": ["totalRows"]
						}
					},
					"failedPages": {
						"$ref": {
							"step": "assemble",
							"path": ["failedPageCount"]
						}
					},
					"dlqUrl": {
						"$tpl": [
							"/exports/",
							{
								"$ref": {
									"step": "@trigger",
									"path": ["body", "exportId"]
								}
							},
							"/failures"
						]
					}
				}
			}
		}
	]
}
