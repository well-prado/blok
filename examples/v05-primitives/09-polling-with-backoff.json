{
	"name": "Poll With Exponential Backoff",
	"version": "1.0.0",
	"description": "Polls an external service on a fixed 2s interval, stopping when the response is ready OR after 5 attempts (~10s total). Demonstrates: loop with a computed-from-state condition, and maxIterations as a hard safety cap mirroring the while condition. NOTE: `wait.for` is LITERAL-ONLY — it is parsed at workflow LOAD time, before any request ctx exists, so it cannot reference step state. Exponential backoff driven by a computed delay is therefore not expressible with `wait` today; do it inside a node instead.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/poll",
			"accept": "application/json"
		}
	},
	"steps": [
		{
			"id": "init-attempt",
			"use": "ctx-publish",
			"type": "module",
			"inputs": {
				"name": "attempt",
				"value": 0
			}
		},
		{
			"id": "poll-with-backoff",
			"loop": {
				"while": "ctx.state.lastStatus !== 'ready' && ctx.state.attempt < 5",
				"maxIterations": 5,
				"do": [
					{
						"id": "wait-backoff",
						"wait": {
							"for": "2s"
						}
					},
					{
						"id": "check",
						"use": "@blokjs/api-call",
						"type": "module",
						"maxDuration": "5s",
						"inputs": {
							"url": {
								"$ref": {
									"step": "@trigger",
									"path": ["body", "url"]
								}
							},
							"method": "GET"
						}
					},
					{
						"id": "advance",
						"use": "ctx-publish-many",
						"type": "module",
						"inputs": {
							"values": {
								"lastStatus": {
									"$ref": {
										"step": "check",
										"path": ["status"]
									}
								},
								"attempt": "js/ctx.state.attempt + 1"
							}
						}
					}
				]
			}
		},
		{
			"id": "respond",
			"use": "@blokjs/respond",
			"type": "module",
			"inputs": {
				"status": 200,
				"body": {
					"ready": "js/ctx.state.lastStatus === 'ready'",
					"attempts": {
						"$ref": {
							"step": "attempt",
							"path": []
						}
					},
					"finalStatus": {
						"$ref": {
							"step": "lastStatus",
							"path": []
						}
					},
					"data": {
						"$ref": {
							"step": "check",
							"path": []
						}
					}
				}
			}
		}
	]
}
