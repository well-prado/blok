{
	"name": "Poll With Exponential Backoff",
	"version": "1.0.0",
	"description": "Polls an external service with exponential backoff (1s, 2s, 4s, 8s, 16s), stopping when the response is ready OR after 5 attempts (~31s total). Demonstrates: a loop with a computed-from-state condition, maxIterations as a hard safety cap mirroring the while condition, and a DYNAMIC wait — `wait.for` takes a structural ref to the step that computed the delay, resolved against the live ctx when the wait step executes (#704). The wait still defers through the durable scheduler, so the backoff survives a process restart.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/poll",
			"accept": "application/json"
		}
	},
	"steps": [
		{
			"id": "init-attempt",
			"use": "ctx-publish",
			"type": "module",
			"inputs": {
				"name": "attempt",
				"value": 0
			}
		},
		{
			"id": "poll-with-backoff",
			"loop": {
				"while": "ctx.state.lastStatus !== 'ready' && ctx.state.attempt < 5",
				"maxIterations": 5,
				"do": [
					{
						"id": "compute-delay",
						"use": "@blokjs/expr",
						"type": "module",
						"inputs": {
							"expression": "Math.pow(2, ctx.state.attempt) * 1000"
						}
					},
					{
						"id": "wait-backoff",
						"wait": {
							"for": {
								"$ref": {
									"step": "compute-delay",
									"path": []
								}
							}
						}
					},
					{
						"id": "check",
						"use": "@blokjs/api-call",
						"type": "module",
						"maxDuration": "5s",
						"inputs": {
							"url": {
								"$ref": {
									"step": "@trigger",
									"path": ["body", "url"]
								}
							},
							"method": "GET"
						}
					},
					{
						"id": "advance",
						"use": "ctx-publish-many",
						"type": "module",
						"inputs": {
							"values": {
								"lastStatus": {
									"$ref": {
										"step": "check",
										"path": ["status"]
									}
								},
								"attempt": "js/ctx.state.attempt + 1"
							}
						}
					}
				]
			}
		},
		{
			"id": "respond",
			"use": "@blokjs/respond",
			"type": "module",
			"inputs": {
				"status": 200,
				"body": {
					"ready": "js/ctx.state.lastStatus === 'ready'",
					"attempts": {
						"$ref": {
							"step": "attempt",
							"path": []
						}
					},
					"finalStatus": {
						"$ref": {
							"step": "lastStatus",
							"path": []
						}
					},
					"data": {
						"$ref": {
							"step": "check",
							"path": []
						}
					}
				}
			}
		}
	]
}
