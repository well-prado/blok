{
	"name": "Travel Booking Saga",
	"version": "1.0.0",
	"description": "Books a flight + hotel + car as a saga. If any step fails, the previously successful steps are compensated in reverse order — cancel car if hotel failed, cancel hotel if car failed, etc. The catch arm reads ctx.state to know which steps succeeded and conditionally undoes them. Demonstrates: tryCatch with manual compensation chain in catch, branch guards on each compensation so we don't try to cancel things that never got booked, ctx.error to surface which step failed in the response. This is the classic saga pattern done declaratively rather than with imperative code.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/travel/book",
			"middleware": [
				"auth-check"
			]
		}
	},
	"steps": [
		{
			"id": "saga",
			"tryCatch": {
				"try": [
					{
						"id": "book-flight",
						"use": "flight-api",
						"type": "module",
						"idempotencyKey": "js/`flight-${ctx.request.body.bookingId}`",
						"inputs": {
							"action": "book",
							"from": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"from"
									]
								}
							},
							"to": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"to"
									]
								}
							},
							"date": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"date"
									]
								}
							},
							"passenger": {
								"$ref": {
									"step": "identity",
									"path": [
										"sub"
									]
								}
							}
						}
					},
					{
						"id": "book-hotel",
						"use": "hotel-api",
						"type": "module",
						"idempotencyKey": "js/`hotel-${ctx.request.body.bookingId}`",
						"inputs": {
							"action": "book",
							"city": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"to"
									]
								}
							},
							"checkIn": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"date"
									]
								}
							},
							"nights": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"nights"
									]
								}
							},
							"guest": {
								"$ref": {
									"step": "identity",
									"path": [
										"sub"
									]
								}
							}
						}
					},
					{
						"id": "book-car",
						"use": "car-api",
						"type": "module",
						"idempotencyKey": "js/`car-${ctx.request.body.bookingId}`",
						"inputs": {
							"action": "book",
							"city": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"to"
									]
								}
							},
							"pickup": {
								"$ref": {
									"step": "@trigger",
									"path": [
										"body",
										"date"
									]
								}
							},
							"return": {
								"$tpl": [
									"",
									{
										"$ref": {
											"step": "@trigger",
											"path": [
												"body",
												"date"
											]
										}
									},
									" + ",
									{
										"$ref": {
											"step": "@trigger",
											"path": [
												"body",
												"nights"
											]
										}
									},
									" days"
								]
							},
							"driver": {
								"$ref": {
									"step": "identity",
									"path": [
										"sub"
									]
								}
							}
						}
					},
					{
						"id": "respond-ok",
						"use": "@blokjs/respond",
						"type": "module",
						"inputs": {
							"status": 201,
							"body": {
								"bookingId": {
									"$ref": {
										"step": "@trigger",
										"path": [
											"body",
											"bookingId"
										]
									}
								},
								"flight": {
									"$ref": {
										"step": "book-flight",
										"path": [
											"id"
										]
									}
								},
								"hotel": {
									"$ref": {
										"step": "book-hotel",
										"path": [
											"id"
										]
									}
								},
								"car": {
									"$ref": {
										"step": "book-car",
										"path": [
											"id"
										]
									}
								}
							}
						}
					}
				],
				"catch": [
					{
						"id": "compensate-car",
						"branch": {
							"when": "ctx.state['book-car'] !== undefined",
							"then": [
								{
									"id": "cancel-car",
									"use": "car-api",
									"type": "module",
									"inputs": {
										"action": "cancel",
										"id": {
											"$ref": {
												"step": "book-car",
												"path": [
													"id"
												]
											}
										},
										"reason": "saga-rollback"
									}
								}
							]
						}
					},
					{
						"id": "compensate-hotel",
						"branch": {
							"when": "ctx.state['book-hotel'] !== undefined",
							"then": [
								{
									"id": "cancel-hotel",
									"use": "hotel-api",
									"type": "module",
									"inputs": {
										"action": "cancel",
										"id": {
											"$ref": {
												"step": "book-hotel",
												"path": [
													"id"
												]
											}
										},
										"reason": "saga-rollback"
									}
								}
							]
						}
					},
					{
						"id": "compensate-flight",
						"branch": {
							"when": "ctx.state['book-flight'] !== undefined",
							"then": [
								{
									"id": "cancel-flight",
									"use": "flight-api",
									"type": "module",
									"inputs": {
										"action": "cancel",
										"id": {
											"$ref": {
												"step": "book-flight",
												"path": [
													"id"
												]
											}
										},
										"reason": "saga-rollback"
									}
								}
							]
						}
					},
					{
						"id": "respond-failed",
						"use": "@blokjs/respond",
						"type": "module",
						"inputs": {
							"status": 502,
							"body": {
								"error": "Booking saga rolled back",
								"failedAt": {
									"$ref": {
										"step": "@error",
										"path": [
											"name"
										]
									}
								},
								"reason": {
									"$ref": {
										"step": "@error",
										"path": [
											"message"
										]
									}
								},
								"bookingId": {
									"$ref": {
										"step": "@trigger",
										"path": [
											"body",
											"bookingId"
										]
									}
								}
							}
						}
					}
				]
			}
		}
	]
}
