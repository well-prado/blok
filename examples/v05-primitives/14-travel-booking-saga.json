{
	"name": "Travel Booking Saga",
	"version": "1.0.0",
	"description": "Books a flight + hotel + car as a saga. If any step fails, the previously successful steps are compensated in reverse order — cancel car if hotel failed, cancel hotel if car failed, etc. The catch arm reads ctx.state to know which steps succeeded and conditionally undoes them. Demonstrates: tryCatch with manual compensation chain in catch, branch guards on each compensation so we don't try to cancel things that never got booked, ctx.error to surface which step failed in the response. This is the classic saga pattern done declaratively rather than with imperative code.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/travel/book",
			"middleware": ["auth-check"]
		}
	},
	"steps": [
		{
			"id": "saga",
			"tryCatch": {
				"try": [
					{
						"id": "book-flight",
						"use": "flight-api",
						"type": "module",
						"idempotencyKey": "js/`flight-${ctx.request.body.bookingId}`",
						"inputs": {
							"action": "book",
							"from": "js/ctx.request.body.from",
							"to": "js/ctx.request.body.to",
							"date": "js/ctx.request.body.date",
							"passenger": "js/ctx.state.identity.sub"
						}
					},
					{
						"id": "book-hotel",
						"use": "hotel-api",
						"type": "module",
						"idempotencyKey": "js/`hotel-${ctx.request.body.bookingId}`",
						"inputs": {
							"action": "book",
							"city": "js/ctx.request.body.to",
							"checkIn": "js/ctx.request.body.date",
							"nights": "js/ctx.request.body.nights",
							"guest": "js/ctx.state.identity.sub"
						}
					},
					{
						"id": "book-car",
						"use": "car-api",
						"type": "module",
						"idempotencyKey": "js/`car-${ctx.request.body.bookingId}`",
						"inputs": {
							"action": "book",
							"city": "js/ctx.request.body.to",
							"pickup": "js/ctx.request.body.date",
							"return": "js/`${ctx.request.body.date} + ${ctx.request.body.nights} days`",
							"driver": "js/ctx.state.identity.sub"
						}
					},
					{
						"id": "respond-ok",
						"use": "@blokjs/respond",
						"type": "module",
						"inputs": {
							"status": 201,
							"body": {
								"bookingId": "js/ctx.request.body.bookingId",
								"flight": "js/ctx.state['book-flight'].id",
								"hotel": "js/ctx.state['book-hotel'].id",
								"car": "js/ctx.state['book-car'].id"
							}
						}
					}
				],
				"catch": [
					{
						"id": "compensate-car",
						"branch": {
							"when": "ctx.state['book-car'] !== undefined",
							"then": [
								{
									"id": "cancel-car",
									"use": "car-api",
									"type": "module",
									"inputs": {
										"action": "cancel",
										"id": "js/ctx.state['book-car'].id",
										"reason": "saga-rollback"
									}
								}
							]
						}
					},
					{
						"id": "compensate-hotel",
						"branch": {
							"when": "ctx.state['book-hotel'] !== undefined",
							"then": [
								{
									"id": "cancel-hotel",
									"use": "hotel-api",
									"type": "module",
									"inputs": {
										"action": "cancel",
										"id": "js/ctx.state['book-hotel'].id",
										"reason": "saga-rollback"
									}
								}
							]
						}
					},
					{
						"id": "compensate-flight",
						"branch": {
							"when": "ctx.state['book-flight'] !== undefined",
							"then": [
								{
									"id": "cancel-flight",
									"use": "flight-api",
									"type": "module",
									"inputs": {
										"action": "cancel",
										"id": "js/ctx.state['book-flight'].id",
										"reason": "saga-rollback"
									}
								}
							]
						}
					},
					{
						"id": "respond-failed",
						"use": "@blokjs/respond",
						"type": "module",
						"inputs": {
							"status": 502,
							"body": {
								"error": "Booking saga rolled back",
								"failedAt": "js/ctx.error.name",
								"reason": "js/ctx.error.message",
								"bookingId": "js/ctx.request.body.bookingId"
							}
						}
					}
				]
			}
		}
	]
}
