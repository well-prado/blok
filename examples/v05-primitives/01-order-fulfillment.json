{
	"name": "Order Fulfillment",
	"version": "1.0.0",
	"description": "E-commerce order endpoint. Auth + rate-limit middleware run first. Then validate the body, route by order type (physical/digital/subscription), fan out line items in parallel for inventory + reservation, charge payment with retry, and audit the outcome regardless of success or failure. Demonstrates: trigger-level middleware chain, switch with array `when`, forEach parallel with concurrency cap, tryCatch with finally, ctx.error in the catch arm.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/orders",
			"accept": "application/json",
			"middleware": ["auth-check", "rate-limit"]
		}
	},
	"steps": [
		{
			"id": "validate-body",
			"use": "@blokjs/json-schema",
			"type": "module",
			"inputs": {
				"schema": {
					"type": "object",
					"required": ["type", "items", "total", "currency"]
				},
				"data": {
					"$ref": {
						"step": "@trigger",
						"path": ["body"]
					}
				}
			}
		},
		{
			"id": "route-by-order-type",
			"switch": {
				"on": "js/ctx.request.body.type",
				"cases": [
					{
						"when": ["physical", "subscription"],
						"do": [
							{
								"id": "process-items",
								"forEach": {
									"in": "js/ctx.request.body.items",
									"as": "item",
									"mode": "parallel",
									"concurrency": 5,
									"do": [
										{
											"id": "check-inventory",
											"use": "inventory-check",
											"type": "module",
											"inputs": {
												"sku": {
													"$ref": {
														"step": "item",
														"path": ["sku"]
													}
												},
												"qty": {
													"$ref": {
														"step": "item",
														"path": ["quantity"]
													}
												}
											}
										},
										{
											"id": "reserve",
											"use": "inventory-reserve",
											"type": "module",
											"idempotencyKey": "js/`${ctx.request.body.id}-${ctx.state.item.sku}`",
											"inputs": {
												"sku": {
													"$ref": {
														"step": "item",
														"path": ["sku"]
													}
												},
												"qty": {
													"$ref": {
														"step": "item",
														"path": ["quantity"]
													}
												},
												"orderId": {
													"$ref": {
														"step": "@trigger",
														"path": ["body", "id"]
													}
												}
											}
										}
									]
								}
							}
						]
					},
					{
						"when": "digital",
						"do": [
							{
								"id": "generate-license",
								"use": "license-create",
								"type": "module",
								"inputs": {
									"productId": {
										"$ref": {
											"step": "@trigger",
											"path": ["body", "productId"]
										}
									},
									"userId": {
										"$ref": {
											"step": "identity",
											"path": ["sub"]
										}
									}
								}
							}
						]
					}
				],
				"default": [
					{
						"id": "respond-bad-type",
						"use": "@blokjs/respond",
						"type": "module",
						"inputs": {
							"status": 400,
							"body": {
								"error": "Unknown order type"
							}
						},
						"stop": true
					}
				]
			}
		},
		{
			"id": "charge-payment",
			"tryCatch": {
				"try": [
					{
						"id": "stripe-charge",
						"use": "stripe-charge",
						"type": "module",
						"idempotencyKey": "js/ctx.request.body.id",
						"retry": {
							"maxAttempts": 3,
							"minTimeoutInMs": 500,
							"factor": 2
						},
						"maxDuration": "10s",
						"inputs": {
							"amount": {
								"$ref": {
									"step": "@trigger",
									"path": ["body", "total"]
								}
							},
							"currency": {
								"$ref": {
									"step": "@trigger",
									"path": ["body", "currency"]
								}
							},
							"customerId": {
								"$ref": {
									"step": "identity",
									"path": ["stripeCustomerId"]
								}
							}
						}
					}
				],
				"catch": [
					{
						"id": "notify-slack",
						"use": "@blokjs/api-call",
						"type": "module",
						"inputs": {
							"url": "js/ctx.env.SLACK_WEBHOOK_URL",
							"method": "POST",
							"body": {
								"text": "js/`Charge failed for order ${ctx.request.body.id}: ${ctx.error.message}`"
							}
						}
					},
					{
						"id": "respond-payment-failed",
						"use": "@blokjs/respond",
						"type": "module",
						"inputs": {
							"status": 402,
							"body": {
								"error": "Payment failed",
								"orderId": {
									"$ref": {
										"step": "@trigger",
										"path": ["body", "id"]
									}
								},
								"reason": {
									"$ref": {
										"step": "@error",
										"path": ["message"]
									}
								}
							}
						},
						"stop": true
					}
				],
				"finally": [
					{
						"id": "audit-outcome",
						"use": "audit-log",
						"type": "module",
						"inputs": {
							"event": "order-fulfillment",
							"orderId": {
								"$ref": {
									"step": "@trigger",
									"path": ["body", "id"]
								}
							},
							"userId": {
								"$ref": {
									"step": "identity",
									"path": ["sub"]
								}
							},
							"total": {
								"$ref": {
									"step": "@trigger",
									"path": ["body", "total"]
								}
							}
						}
					}
				]
			}
		},
		{
			"id": "respond-created",
			"use": "@blokjs/respond",
			"type": "module",
			"inputs": {
				"status": 201,
				"body": {
					"orderId": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "id"]
						}
					},
					"chargeId": {
						"$ref": {
							"step": "stripe-charge",
							"path": ["id"]
						}
					}
				}
			}
		}
	]
}
