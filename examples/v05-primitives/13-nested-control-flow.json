{
	"name": "Order Processing With Per-Item Routing",
	"version": "1.0.0",
	"description": "Worst-case nesting demo. For each line item in an order, we wrap the per-item processing in tryCatch, route by item type via switch, then inside the switch each case is a sub-pipeline of regular steps. The catch arm uses a branch to decide whether one bad item should fail the whole order (required items) or be silently skipped (optional). Shows that the four flow primitives (forEach, tryCatch, switch, branch) all nest cleanly without ceremony — the JSON stays readable because each nesting level adds exactly one layer of indentation. Demonstrates: forEach > tryCatch > switch > regular steps, plus tryCatch.catch > branch in the catch arm.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/orders/process",
			"middleware": [
				"auth-check"
			]
		}
	},
	"steps": [
		{
			"id": "per-item-pipeline",
			"forEach": {
				"in": "js/ctx.request.body.items",
				"as": "item",
				"mode": "sequential",
				"do": [
					{
						"id": "item-tryCatch",
						"tryCatch": {
							"try": [
								{
									"id": "by-type",
									"switch": {
										"on": "js/ctx.state.item.type",
										"cases": [
											{
												"when": "physical",
												"do": [
													{
														"id": "reserve",
														"use": "inventory-reserve",
														"type": "module",
														"inputs": {
															"sku": {
																"$ref": {
																	"step": "item",
																	"path": [
																		"sku"
																	]
																}
															},
															"qty": {
																"$ref": {
																	"step": "item",
																	"path": [
																		"qty"
																	]
																}
															}
														}
													},
													{
														"id": "schedule-ship",
														"use": "shipping-schedule",
														"type": "module",
														"inputs": {
															"address": {
																"$ref": {
																	"step": "@trigger",
																	"path": [
																		"body",
																		"shipTo"
																	]
																}
															},
															"sku": {
																"$ref": {
																	"step": "item",
																	"path": [
																		"sku"
																	]
																}
															}
														}
													}
												]
											},
											{
												"when": "digital",
												"do": [
													{
														"id": "generate-license",
														"use": "license-create",
														"type": "module",
														"inputs": {
															"productId": {
																"$ref": {
																	"step": "item",
																	"path": [
																		"productId"
																	]
																}
															},
															"userId": {
																"$ref": {
																	"step": "identity",
																	"path": [
																		"sub"
																	]
																}
															}
														}
													}
												]
											},
											{
												"when": "service",
												"do": [
													{
														"id": "schedule-service",
														"use": "service-schedule",
														"type": "module",
														"inputs": {
															"kind": {
																"$ref": {
																	"step": "item",
																	"path": [
																		"serviceKind"
																	]
																}
															},
															"date": {
																"$ref": {
																	"step": "item",
																	"path": [
																		"scheduledFor"
																	]
																}
															},
															"customerId": {
																"$ref": {
																	"step": "identity",
																	"path": [
																		"sub"
																	]
																}
															}
														}
													}
												]
											}
										],
										"default": [
											{
												"id": "throw-unknown",
												"use": "throw",
												"type": "module",
												"inputs": {
													"message": {
														"$tpl": [
															"Unknown item type: ",
															{
																"$ref": {
																	"step": "item",
																	"path": [
																		"type"
																	]
																}
															},
															""
														]
													}
												}
											}
										]
									}
								}
							],
							"catch": [
								{
									"id": "audit-item-failure",
									"use": "audit-log",
									"type": "module",
									"inputs": {
										"event": "item-process-failure",
										"item": {
											"$ref": {
												"step": "item",
												"path": []
											}
										},
										"error": {
											"$ref": {
												"step": "@error",
												"path": [
													"message"
												]
											}
										}
									}
								},
								{
									"id": "decide-on-failure",
									"branch": {
										"when": "ctx.state.item.required === true",
										"then": [
											{
												"id": "rethrow",
												"use": "throw",
												"type": "module",
												"inputs": {
													"message": "js/`Required item ${ctx.state.item.sku} failed: ${ctx.error.message}`"
												}
											}
										],
										"else": [
											{
												"id": "skip-and-log",
												"use": "log",
												"type": "module",
												"inputs": {
													"level": "warn",
													"message": "js/`Optional item ${ctx.state.item.sku} skipped due to: ${ctx.error.message}`"
												}
											}
										]
									}
								}
							]
						}
					}
				]
			}
		},
		{
			"id": "respond",
			"use": "@blokjs/respond",
			"type": "module",
			"inputs": {
				"status": 200,
				"body": {
					"orderId": {
						"$ref": {
							"step": "@trigger",
							"path": [
								"body",
								"id"
							]
						}
					},
					"itemsProcessed": {
						"$ref": {
							"step": "per-item-pipeline",
							"path": [
								"length"
							]
						}
					}
				}
			}
		}
	]
}
