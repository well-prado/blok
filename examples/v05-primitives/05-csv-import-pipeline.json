{
	"name": "CSV Import Pipeline",
	"version": "1.0.0",
	"description": "Receives a CSV file in the body, parses it, and processes each row through validate -> transform -> insert. Each row is wrapped in its own tryCatch so a single bad row doesn't abort the import — failed rows go to a dead-letter table for later inspection. Demonstrates: forEach (sequential, since DB inserts shouldn't run wild) + per-iteration tryCatch + DLQ pattern.",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/imports/csv",
			"accept": "text/csv",
			"middleware": ["auth-check", "admin-only"]
		}
	},
	"steps": [
		{
			"id": "parse-csv",
			"use": "csv-parser",
			"type": "module",
			"inputs": {
				"data": "js/ctx.request.body",
				"headers": true,
				"delimiter": ","
			}
		},
		{
			"id": "process-rows",
			"forEach": {
				"in": "js/ctx.state['parse-csv'].rows",
				"as": "row",
				"mode": "sequential",
				"do": [
					{
						"id": "import-row",
						"tryCatch": {
							"try": [
								{
									"id": "validate",
									"use": "row-validator",
									"type": "module",
									"inputs": {
										"row": "js/ctx.state.row",
										"rowNumber": "js/ctx.state.rowIndex"
									}
								},
								{
									"id": "transform",
									"use": "row-transformer",
									"type": "module",
									"inputs": {
										"row": "js/ctx.state.row"
									}
								},
								{
									"id": "insert",
									"use": "db-insert",
									"type": "module",
									"idempotencyKey": "js/`${ctx.request.body.importId}-${ctx.state.rowIndex}`",
									"inputs": {
										"table": "users",
										"data": "js/ctx.state.transform"
									}
								}
							],
							"catch": [
								{
									"id": "send-to-dlq",
									"use": "db-insert",
									"type": "module",
									"inputs": {
										"table": "import_failures",
										"data": {
											"importId": "js/ctx.request.body.importId",
											"rowNumber": "js/ctx.state.rowIndex",
											"row": "js/ctx.state.row",
											"error": "js/ctx.error.message",
											"errorCode": "js/ctx.error.code",
											"failedAt": "new Date().toISOString()"
										}
									}
								}
							]
						}
					}
				]
			}
		},
		{
			"id": "summarize",
			"use": "import-summary",
			"type": "module",
			"inputs": {
				"results": "js/ctx.state['process-rows']",
				"importId": "js/ctx.request.body.importId"
			}
		},
		{
			"id": "respond",
			"use": "@blokjs/respond",
			"type": "module",
			"inputs": {
				"status": 200,
				"body": {
					"importId": "js/ctx.request.body.importId",
					"totalRows": "js/ctx.state['parse-csv'].rows.length",
					"succeeded": "js/ctx.state.summarize.succeeded",
					"failed": "js/ctx.state.summarize.failed",
					"dlqUrl": "js/`/imports/csv/${ctx.request.body.importId}/failures`"
				}
			}
		}
	]
}
