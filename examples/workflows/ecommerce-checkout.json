{
	"name": "E-Commerce Checkout",
	"description": "Complete e-commerce checkout flow: validates the cart, checks inventory for all items, processes payment through Stripe, creates the order record, and sends an order confirmation email.",
	"version": "1.0.0",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/api/checkout",
			"accept": "application/json"
		}
	},
	"steps": [
		{
			"name": "validate-cart",
			"node": "@blokjs/json-validator",
			"type": "module"
		},
		{
			"name": "calculate-totals",
			"node": "cart-calculator",
			"type": "module"
		},
		{
			"name": "check-inventory",
			"node": "@blokjs/api-call",
			"type": "module"
		},
		{
			"name": "route-inventory-check",
			"node": "@blokjs/if-else",
			"type": "module"
		}
	],
	"nodes": {
		"validate-cart": {
			"inputs": {
				"schema": {
					"type": "object",
					"required": ["items", "customer", "shippingAddress", "paymentMethod"],
					"properties": {
						"items": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "object",
								"required": ["productId", "quantity", "price"],
								"properties": {
									"productId": {
										"type": "string"
									},
									"quantity": {
										"type": "integer",
										"minimum": 1
									},
									"price": {
										"type": "number",
										"minimum": 0
									}
								}
							}
						},
						"customer": {
							"type": "object",
							"required": ["id", "email"],
							"properties": {
								"id": {
									"type": "string"
								},
								"email": {
									"type": "string",
									"format": "email"
								}
							}
						},
						"shippingAddress": {
							"type": "object",
							"required": ["line1", "city", "state", "postalCode", "country"],
							"properties": {
								"line1": {
									"type": "string"
								},
								"line2": {
									"type": "string"
								},
								"city": {
									"type": "string"
								},
								"state": {
									"type": "string"
								},
								"postalCode": {
									"type": "string"
								},
								"country": {
									"type": "string"
								}
							}
						},
						"paymentMethod": {
							"type": "object",
							"required": ["type", "token"],
							"properties": {
								"type": {
									"type": "string",
									"enum": ["card", "bank_transfer"]
								},
								"token": {
									"type": "string"
								}
							}
						}
					}
				},
				"data": {
					"$ref": {
						"step": "@trigger",
						"path": ["body"]
					}
				}
			}
		},
		"calculate-totals": {
			"inputs": {
				"items": {
					"$ref": {
						"step": "@trigger",
						"path": ["body", "items"]
					}
				},
				"shippingAddress": {
					"$ref": {
						"step": "@trigger",
						"path": ["body", "shippingAddress"]
					}
				},
				"couponCode": {
					"$ref": {
						"step": "@trigger",
						"path": ["body", "couponCode"]
					}
				},
				"taxRateApiUrl": "${process.env.TAX_SERVICE_URL}/api/rates"
			}
		},
		"check-inventory": {
			"inputs": {
				"url": "${process.env.INVENTORY_SERVICE_URL}/api/inventory/check-batch",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.INTERNAL_API_KEY}"
				},
				"body": {
					"items": "js/ctx.request.body.items.map(item => ({ productId: item.productId, requestedQuantity: item.quantity }))"
				},
				"responseType": "application/json"
			}
		},
		"route-inventory-check": {
			"conditions": [
				{
					"type": "if",
					"condition": "ctx.response.data.allAvailable === true",
					"steps": [
						{
							"name": "process-payment",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "route-payment-result",
							"node": "@blokjs/if-else",
							"type": "module"
						}
					]
				},
				{
					"type": "else",
					"steps": [
						{
							"name": "inventory-unavailable-response",
							"node": "mapper",
							"type": "module"
						}
					]
				}
			]
		},
		"process-payment": {
			"inputs": {
				"url": "https://api.stripe.com/v1/payment_intents",
				"method": "POST",
				"headers": {
					"Content-Type": "application/x-www-form-urlencoded",
					"Authorization": "Bearer ${process.env.STRIPE_SECRET_KEY}"
				},
				"body": {
					"amount": "js/Math.round(ctx.vars['calculate-totals'].totalAmount * 100)",
					"currency": "usd",
					"payment_method": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "paymentMethod", "token"]
						}
					},
					"confirm": true,
					"metadata[customer_id]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "customer", "id"]
						}
					},
					"metadata[order_source]": "checkout_workflow",
					"receipt_email": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "customer", "email"]
						}
					},
					"shipping[name]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "customer", "name"]
						}
					},
					"shipping[address][line1]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "shippingAddress", "line1"]
						}
					},
					"shipping[address][city]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "shippingAddress", "city"]
						}
					},
					"shipping[address][state]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "shippingAddress", "state"]
						}
					},
					"shipping[address][postal_code]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "shippingAddress", "postalCode"]
						}
					},
					"shipping[address][country]": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "shippingAddress", "country"]
						}
					}
				},
				"responseType": "application/json"
			}
		},
		"route-payment-result": {
			"conditions": [
				{
					"type": "if",
					"condition": "ctx.response.data.status === 'succeeded'",
					"steps": [
						{
							"name": "reserve-inventory",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "create-order",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "send-confirmation-email",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "checkout-success-response",
							"node": "mapper",
							"type": "module"
						}
					]
				},
				{
					"type": "else",
					"steps": [
						{
							"name": "payment-failed-response",
							"node": "mapper",
							"type": "module"
						}
					]
				}
			]
		},
		"reserve-inventory": {
			"inputs": {
				"url": "${process.env.INVENTORY_SERVICE_URL}/api/inventory/reserve",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.INTERNAL_API_KEY}"
				},
				"body": {
					"items": "js/ctx.request.body.items.map(item => ({ productId: item.productId, quantity: item.quantity }))",
					"reservationTtl": 3600,
					"paymentIntentId": {
						"$ref": {
							"step": "process-payment",
							"path": ["id"]
						}
					}
				},
				"responseType": "application/json"
			}
		},
		"create-order": {
			"inputs": {
				"url": "${process.env.ORDER_SERVICE_URL}/api/orders",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.INTERNAL_API_KEY}"
				},
				"body": {
					"customerId": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "customer", "id"]
						}
					},
					"items": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "items"]
						}
					},
					"shippingAddress": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "shippingAddress"]
						}
					},
					"subtotal": {
						"$ref": {
							"step": "calculate-totals",
							"path": ["subtotal"]
						}
					},
					"tax": {
						"$ref": {
							"step": "calculate-totals",
							"path": ["tax"]
						}
					},
					"shipping": {
						"$ref": {
							"step": "calculate-totals",
							"path": ["shippingCost"]
						}
					},
					"discount": {
						"$ref": {
							"step": "calculate-totals",
							"path": ["discount"]
						}
					},
					"totalAmount": {
						"$ref": {
							"step": "calculate-totals",
							"path": ["totalAmount"]
						}
					},
					"paymentIntentId": {
						"$ref": {
							"step": "process-payment",
							"path": ["id"]
						}
					},
					"paymentStatus": "paid",
					"status": "confirmed"
				},
				"responseType": "application/json"
			}
		},
		"send-confirmation-email": {
			"inputs": {
				"url": "https://api.sendgrid.com/v3/mail/send",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.SENDGRID_API_KEY}"
				},
				"body": {
					"personalizations": [
						{
							"to": [
								{
									"email": {
										"$ref": {
											"step": "@trigger",
											"path": ["body", "customer", "email"]
										}
									}
								}
							],
							"dynamic_template_data": {
								"orderId": {
									"$ref": {
										"step": "create-order",
										"path": ["orderId"]
									}
								},
								"customerName": {
									"$ref": {
										"step": "@trigger",
										"path": ["body", "customer", "name"]
									}
								},
								"items": {
									"$ref": {
										"step": "@trigger",
										"path": ["body", "items"]
									}
								},
								"subtotal": {
									"$ref": {
										"step": "calculate-totals",
										"path": ["subtotal"]
									}
								},
								"tax": {
									"$ref": {
										"step": "calculate-totals",
										"path": ["tax"]
									}
								},
								"shipping": {
									"$ref": {
										"step": "calculate-totals",
										"path": ["shippingCost"]
									}
								},
								"total": {
									"$ref": {
										"step": "calculate-totals",
										"path": ["totalAmount"]
									}
								},
								"shippingAddress": {
									"$ref": {
										"step": "@trigger",
										"path": ["body", "shippingAddress"]
									}
								},
								"orderTrackingUrl": "js/`${process.env.APP_URL}/orders/${ctx.state['create-order'].orderId}`"
							}
						}
					],
					"from": {
						"email": "${process.env.FROM_EMAIL}",
						"name": "${process.env.STORE_NAME}"
					},
					"template_id": "${process.env.ORDER_CONFIRMATION_TEMPLATE_ID}"
				},
				"responseType": "application/json"
			}
		},
		"checkout-success-response": {
			"inputs": {
				"model": {
					"success": true,
					"orderId": {
						"$ref": {
							"step": "create-order",
							"path": ["orderId"]
						}
					},
					"status": "confirmed",
					"paymentStatus": "paid",
					"total": {
						"$ref": {
							"step": "calculate-totals",
							"path": ["totalAmount"]
						}
					},
					"currency": "usd",
					"estimatedDelivery": "js/new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]"
				}
			}
		},
		"inventory-unavailable-response": {
			"inputs": {
				"model": {
					"success": false,
					"error": "INVENTORY_UNAVAILABLE",
					"message": "One or more items in your cart are no longer available.",
					"unavailableItems": {
						"$ref": {
							"step": "check-inventory",
							"path": ["unavailableItems"]
						}
					}
				}
			}
		},
		"payment-failed-response": {
			"inputs": {
				"model": {
					"success": false,
					"error": "PAYMENT_FAILED",
					"message": "Payment could not be processed. Please check your payment details and try again.",
					"paymentStatus": {
						"$ref": {
							"step": "process-payment",
							"path": ["status"]
						}
					}
				}
			}
		}
	}
}
