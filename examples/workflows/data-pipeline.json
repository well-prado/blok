{
	"name": "Data Processing Pipeline",
	"description": "End-to-end data processing pipeline: fetches data from an external API, transforms and validates it, stores results in a database, and sends a completion notification.",
	"version": "1.0.0",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/api/pipeline/run",
			"accept": "application/json"
		}
	},
	"steps": [
		{
			"name": "fetch-source-data",
			"node": "@blokjs/api-call",
			"type": "module"
		},
		{
			"name": "route-fetch-result",
			"node": "@blokjs/if-else",
			"type": "module"
		}
	],
	"nodes": {
		"fetch-source-data": {
			"inputs": {
				"url": {
					"$ref": {
						"step": "@trigger",
						"path": ["body", "sourceUrl"]
					}
				},
				"method": "GET",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.SOURCE_API_KEY}"
				},
				"responseType": "application/json"
			}
		},
		"route-fetch-result": {
			"conditions": [
				{
					"type": "if",
					"condition": "ctx.response.data && ctx.response.data.records && ctx.response.data.records.length > 0",
					"steps": [
						{
							"name": "transform-data",
							"node": "data-transformer",
							"type": "module"
						},
						{
							"name": "validate-transformed-data",
							"node": "@blokjs/json-validator",
							"type": "module"
						},
						{
							"name": "route-validation",
							"node": "@blokjs/if-else",
							"type": "module"
						}
					]
				},
				{
					"type": "else",
					"steps": [
						{
							"name": "no-data-response",
							"node": "mapper",
							"type": "module"
						}
					]
				}
			]
		},
		"transform-data": {
			"inputs": {
				"records": {
					"$ref": {
						"step": "fetch-source-data",
						"path": ["data", "records"]
					}
				},
				"mapping": {
					"id": "$.record_id",
					"name": "$.full_name",
					"email": "$.email_address",
					"createdAt": "$.created_date",
					"status": "$.account_status"
				},
				"filters": {
					"excludeNull": true,
					"trimStrings": true
				}
			}
		},
		"validate-transformed-data": {
			"inputs": {
				"schema": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["id", "name", "email"],
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"email": {
								"type": "string",
								"format": "email"
							}
						}
					}
				},
				"data": {
					"$ref": {
						"step": "transform-data",
						"path": ["data", "transformedRecords"]
					}
				}
			}
		},
		"route-validation": {
			"conditions": [
				{
					"type": "if",
					"condition": "ctx.response.data.valid === true",
					"steps": [
						{
							"name": "store-records",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "send-success-notification",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "format-success-response",
							"node": "mapper",
							"type": "module"
						}
					]
				},
				{
					"type": "else",
					"steps": [
						{
							"name": "send-failure-notification",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "format-error-response",
							"node": "mapper",
							"type": "module"
						}
					]
				}
			]
		},
		"store-records": {
			"inputs": {
				"url": "${process.env.DATABASE_API_URL}/api/records/batch",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.DATABASE_API_KEY}"
				},
				"body": {
					"collection": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "targetCollection"]
						}
					},
					"records": {
						"$ref": {
							"step": "transform-data",
							"path": ["transformedRecords"]
						}
					},
					"upsert": true
				},
				"responseType": "application/json"
			}
		},
		"send-success-notification": {
			"inputs": {
				"url": "${process.env.SLACK_WEBHOOK_URL}",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json"
				},
				"body": {
					"text": {
						"$tpl": [
							"Data pipeline completed successfully. Records processed: ",
							{
								"$ref": {
									"step": "store-records",
									"path": ["insertedCount"]
								}
							},
							". Source: ",
							{
								"$ref": {
									"step": "@trigger",
									"path": ["body", "sourceUrl"]
								}
							}
						]
					}
				},
				"responseType": "application/json"
			}
		},
		"send-failure-notification": {
			"inputs": {
				"url": "${process.env.SLACK_WEBHOOK_URL}",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json"
				},
				"body": {
					"text": {
						"$tpl": [
							"Data pipeline validation failed. Source: ",
							{
								"$ref": {
									"step": "@trigger",
									"path": ["body", "sourceUrl"]
								}
							},
							". Check logs for details."
						]
					}
				},
				"responseType": "application/json"
			}
		},
		"format-success-response": {
			"inputs": {
				"model": {
					"success": true,
					"message": "Pipeline completed successfully.",
					"stats": {
						"fetched": {
							"$ref": {
								"step": "fetch-source-data",
								"path": ["records", "length"]
							}
						},
						"transformed": {
							"$ref": {
								"step": "transform-data",
								"path": ["transformedRecords", "length"]
							}
						},
						"stored": {
							"$ref": {
								"step": "store-records",
								"path": ["insertedCount"]
							}
						}
					}
				}
			}
		},
		"format-error-response": {
			"inputs": {
				"model": {
					"success": false,
					"message": "Pipeline failed during data validation.",
					"errors": {
						"$ref": {
							"step": "validate-transformed-data",
							"path": ["data", "errors"]
						}
					}
				}
			}
		},
		"no-data-response": {
			"inputs": {
				"model": {
					"success": true,
					"message": "No records found at the source. Nothing to process.",
					"stats": {
						"fetched": 0,
						"transformed": 0,
						"stored": 0
					}
				}
			}
		}
	}
}
