{
	"name": "GitHub Webhook Processor",
	"description": "Processes GitHub webhook events: verifies the webhook signature, parses the event payload, routes by event type (push, pull_request, issues), executes the appropriate handler, and returns an acknowledgement.",
	"version": "1.0.0",
	"trigger": {
		"http": {
			"method": "POST",
			"path": "/api/webhooks/github",
			"accept": "application/json"
		}
	},
	"steps": [
		{
			"name": "verify-signature",
			"node": "hmac-verify",
			"type": "module"
		},
		{
			"name": "route-signature-check",
			"node": "@blokjs/if-else",
			"type": "module"
		}
	],
	"nodes": {
		"verify-signature": {
			"inputs": {
				"payload": "js/JSON.stringify(ctx.request.body)",
				"signature": {
					"$ref": {
						"step": "@trigger",
						"path": ["headers", "x-hub-signature-256"]
					}
				},
				"secret": "${process.env.GITHUB_WEBHOOK_SECRET}",
				"algorithm": "sha256"
			}
		},
		"route-signature-check": {
			"conditions": [
				{
					"type": "if",
					"condition": "ctx.response.data.valid === true",
					"steps": [
						{
							"name": "parse-event",
							"node": "mapper",
							"type": "module"
						},
						{
							"name": "route-event-type",
							"node": "@blokjs/if-else",
							"type": "module"
						}
					]
				},
				{
					"type": "else",
					"steps": [
						{
							"name": "signature-invalid",
							"node": "error",
							"type": "module"
						}
					]
				}
			]
		},
		"parse-event": {
			"inputs": {
				"model": {
					"eventType": {
						"$ref": {
							"step": "@trigger",
							"path": ["headers", "x-github-event"]
						}
					},
					"deliveryId": {
						"$ref": {
							"step": "@trigger",
							"path": ["headers", "x-github-delivery"]
						}
					},
					"action": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "action"]
						}
					},
					"repository": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "repository", "full_name"]
						}
					},
					"sender": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "sender", "login"]
						}
					}
				}
			}
		},
		"route-event-type": {
			"conditions": [
				{
					"type": "if",
					"condition": "ctx.request.headers['x-github-event'] === 'push'",
					"steps": [
						{
							"name": "process-push",
							"node": "mapper",
							"type": "module"
						},
						{
							"name": "notify-push",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "trigger-ci-pipeline",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "push-response",
							"node": "mapper",
							"type": "module"
						}
					]
				},
				{
					"type": "if",
					"condition": "ctx.request.headers['x-github-event'] === 'pull_request'",
					"steps": [
						{
							"name": "process-pull-request",
							"node": "mapper",
							"type": "module"
						},
						{
							"name": "notify-pull-request",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "pr-response",
							"node": "mapper",
							"type": "module"
						}
					]
				},
				{
					"type": "if",
					"condition": "ctx.request.headers['x-github-event'] === 'issues'",
					"steps": [
						{
							"name": "process-issue",
							"node": "mapper",
							"type": "module"
						},
						{
							"name": "notify-issue",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "issue-response",
							"node": "mapper",
							"type": "module"
						}
					]
				},
				{
					"type": "else",
					"steps": [
						{
							"name": "log-unhandled-event",
							"node": "@blokjs/api-call",
							"type": "module"
						},
						{
							"name": "unhandled-response",
							"node": "mapper",
							"type": "module"
						}
					]
				}
			]
		},
		"process-push": {
			"inputs": {
				"model": {
					"branch": "js/ctx.request.body.ref.replace('refs/heads/', '')",
					"commits": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "commits", "length"]
						}
					},
					"headCommit": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "head_commit", "message"]
						}
					},
					"pusher": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "pusher", "name"]
						}
					},
					"compareUrl": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "compare"]
						}
					}
				}
			}
		},
		"notify-push": {
			"inputs": {
				"url": "${process.env.SLACK_WEBHOOK_URL}",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json"
				},
				"body": {
					"text": {
						"$tpl": [
							"New push to ",
							{
								"$ref": {
									"step": "parse-event",
									"path": ["repository"]
								}
							},
							" on branch ",
							{
								"$ref": {
									"step": "process-push",
									"path": ["branch"]
								}
							},
							" by ",
							{
								"$ref": {
									"step": "process-push",
									"path": ["pusher"]
								}
							},
							": ",
							{
								"$ref": {
									"step": "process-push",
									"path": ["headCommit"]
								}
							},
							" (",
							{
								"$ref": {
									"step": "process-push",
									"path": ["commits"]
								}
							},
							" commits)"
						]
					}
				},
				"responseType": "application/json"
			}
		},
		"trigger-ci-pipeline": {
			"inputs": {
				"url": "${process.env.CI_PIPELINE_TRIGGER_URL}",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.CI_API_TOKEN}"
				},
				"body": {
					"repository": {
						"$ref": {
							"step": "parse-event",
							"path": ["repository"]
						}
					},
					"branch": {
						"$ref": {
							"step": "process-push",
							"path": ["branch"]
						}
					},
					"commitSha": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "head_commit", "id"]
						}
					}
				},
				"responseType": "application/json"
			}
		},
		"push-response": {
			"inputs": {
				"model": {
					"status": "processed",
					"event": "push",
					"deliveryId": {
						"$ref": {
							"step": "parse-event",
							"path": ["deliveryId"]
						}
					},
					"branch": {
						"$ref": {
							"step": "process-push",
							"path": ["branch"]
						}
					},
					"commits": {
						"$ref": {
							"step": "process-push",
							"path": ["commits"]
						}
					}
				}
			}
		},
		"process-pull-request": {
			"inputs": {
				"model": {
					"prNumber": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "number"]
						}
					},
					"title": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "pull_request", "title"]
						}
					},
					"action": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "action"]
						}
					},
					"author": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "pull_request", "user", "login"]
						}
					},
					"baseBranch": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "pull_request", "base", "ref"]
						}
					},
					"headBranch": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "pull_request", "head", "ref"]
						}
					},
					"url": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "pull_request", "html_url"]
						}
					}
				}
			}
		},
		"notify-pull-request": {
			"inputs": {
				"url": "${process.env.SLACK_WEBHOOK_URL}",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json"
				},
				"body": {
					"text": {
						"$tpl": [
							"PR #",
							{
								"$ref": {
									"step": "process-pull-request",
									"path": ["prNumber"]
								}
							},
							" ",
							{
								"$ref": {
									"step": "process-pull-request",
									"path": ["action"]
								}
							},
							" in ",
							{
								"$ref": {
									"step": "parse-event",
									"path": ["repository"]
								}
							},
							": ",
							{
								"$ref": {
									"step": "process-pull-request",
									"path": ["title"]
								}
							},
							" by ",
							{
								"$ref": {
									"step": "process-pull-request",
									"path": ["author"]
								}
							}
						]
					}
				},
				"responseType": "application/json"
			}
		},
		"pr-response": {
			"inputs": {
				"model": {
					"status": "processed",
					"event": "pull_request",
					"deliveryId": {
						"$ref": {
							"step": "parse-event",
							"path": ["deliveryId"]
						}
					},
					"prNumber": {
						"$ref": {
							"step": "process-pull-request",
							"path": ["prNumber"]
						}
					},
					"action": {
						"$ref": {
							"step": "process-pull-request",
							"path": ["action"]
						}
					}
				}
			}
		},
		"process-issue": {
			"inputs": {
				"model": {
					"issueNumber": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "issue", "number"]
						}
					},
					"title": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "issue", "title"]
						}
					},
					"action": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "action"]
						}
					},
					"author": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "issue", "user", "login"]
						}
					},
					"labels": "js/ctx.request.body.issue.labels.map(l => l.name)",
					"url": {
						"$ref": {
							"step": "@trigger",
							"path": ["body", "issue", "html_url"]
						}
					}
				}
			}
		},
		"notify-issue": {
			"inputs": {
				"url": "${process.env.SLACK_WEBHOOK_URL}",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json"
				},
				"body": {
					"text": {
						"$tpl": [
							"Issue #",
							{
								"$ref": {
									"step": "process-issue",
									"path": ["issueNumber"]
								}
							},
							" ",
							{
								"$ref": {
									"step": "process-issue",
									"path": ["action"]
								}
							},
							" in ",
							{
								"$ref": {
									"step": "parse-event",
									"path": ["repository"]
								}
							},
							": ",
							{
								"$ref": {
									"step": "process-issue",
									"path": ["title"]
								}
							},
							" by ",
							{
								"$ref": {
									"step": "process-issue",
									"path": ["author"]
								}
							}
						]
					}
				},
				"responseType": "application/json"
			}
		},
		"issue-response": {
			"inputs": {
				"model": {
					"status": "processed",
					"event": "issues",
					"deliveryId": {
						"$ref": {
							"step": "parse-event",
							"path": ["deliveryId"]
						}
					},
					"issueNumber": {
						"$ref": {
							"step": "process-issue",
							"path": ["issueNumber"]
						}
					},
					"action": {
						"$ref": {
							"step": "process-issue",
							"path": ["action"]
						}
					}
				}
			}
		},
		"log-unhandled-event": {
			"inputs": {
				"url": "${process.env.LOGGING_API_URL}/api/logs",
				"method": "POST",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer ${process.env.LOGGING_API_KEY}"
				},
				"body": {
					"level": "info",
					"message": "Unhandled GitHub event type received",
					"metadata": {
						"eventType": {
							"$ref": {
								"step": "parse-event",
								"path": ["eventType"]
							}
						},
						"deliveryId": {
							"$ref": {
								"step": "parse-event",
								"path": ["deliveryId"]
							}
						},
						"repository": {
							"$ref": {
								"step": "parse-event",
								"path": ["repository"]
							}
						}
					}
				},
				"responseType": "application/json"
			}
		},
		"unhandled-response": {
			"inputs": {
				"model": {
					"status": "acknowledged",
					"event": {
						"$ref": {
							"step": "parse-event",
							"path": ["eventType"]
						}
					},
					"deliveryId": {
						"$ref": {
							"step": "parse-event",
							"path": ["deliveryId"]
						}
					},
					"message": "Event type not currently handled."
				}
			}
		},
		"signature-invalid": {
			"inputs": {
				"message": "Invalid webhook signature. Request rejected.",
				"statusCode": 401
			}
		}
	}
}
